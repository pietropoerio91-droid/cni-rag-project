# LM Studio API
LM_STUDIO_API_KEY=
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLM_MODEL=llama-3.2-3b-instruct

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Qdrant
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant_db
QDRANT_COLLECTION=cni_documents

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cni_rag.log

# Crawler
CNI_BASE_URL=https://www.cni.it
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=100
CRAWLER_DELAY=1.0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:4200

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5
