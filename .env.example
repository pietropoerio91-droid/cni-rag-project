# Variabili d'ambiente lette dal codice. Sono tutte facoltative: la
# configurazione vera sta nei file YAML in config/.
#
# ATTENZIONE: le variabili di modello, se impostate, SOVRASCRIVONO il YAML.
# E' successo con EMBEDDING_MODEL e ha falsato il run FINAL_V2 (doc/SISTEMA.md
# §11.5): lasciarle commentate salvo esperimenti voluti.

# Modello di embedding (default: embedding.model_name in config/rag_config.yaml)
# EMBEDDING_MODEL=
EMBEDDING_DEVICE=cpu

# LLM (default: sezione llm in config/rag_config.yaml, Ollama con qwen2.5:3b)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Origini ammesse dall'API (il frontend Angular)
API_CORS_ORIGINS=http://localhost:4200

# La collection Qdrant NON si sceglie qui: e' collection_name in
# config/qdrant_config.yaml, modificabile anche dal menu impostazioni del
# frontend (sezione Collection).
